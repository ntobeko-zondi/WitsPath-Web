// Firestore rules for the collections added by the WitsPath Companion.
// MERGE these into the Android app's existing firestore.rules - this file is
// not wired into firebase.json so deploying the website can't overwrite them.
//
// Every companion collection is accessed only by the companionMessage Cloud
// Function (Admin SDK, which bypasses rules). Browsers never read or write
// them directly, so deny all client access.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /chat_sessions/{sessionId} {
      allow read, write: if false;
    }
    match /shared_routes/{shareId} {
      allow read, write: if false;
    }
    // Live trips hold a person's current location: server-only.
    match /live_trips/{tripId} {
      allow read, write: if false;
    }
    match /campus_places/{placeId} {
      allow read, write: if false;
    }
    match /dev_route_fixtures/{fixtureId} {
      allow read, write: if false;
    }
    // Phrase templates are edited through the review workflow (console/Admin
    // SDK), not by app clients.
    match /phrase_templates/{lang}/phrases/{phraseKey} {
      allow read, write: if false;
    }
    // places / path_status / reports may already have rules from the Android
    // app (e.g. signed-in users creating reports) - keep those as they are.
  }
}
