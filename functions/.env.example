# Non-secret settings. Copy to functions/.env (git-ignored). NOTE: Firebase
# deploys functions/.env with the function - never put API keys here.
#
# Secrets:
#   production:  firebase functions:secrets:set ANTHROPIC_API_KEY
#                firebase functions:secrets:set VULAVULA_API_KEY   (or "disabled")
#   local dev:   functions/.secret.local  (git-ignored, not deployed), e.g.
#                ANTHROPIC_API_KEY=...
#                VULAVULA_API_KEY=...

# Routing source of truth:
#   http        - shared routing service (extracted Android A*). Target state.
#   fixture     - PLACEHOLDER hand-seeded routes. Dev only.
#   unavailable - every route request returns an explicit error (default).
ROUTING_MODE=unavailable
ROUTING_SERVICE_URL=

# Firestore collections of the Android app's campus graph (confirm these).
GRAPH_NODES_COLLECTION=nodes
GRAPH_EDGES_COLLECTION=edges
GRAPH_FLOORS_COLLECTION=floors
REPORTS_COLLECTION=reports

# Optional model override (defaults to claude-haiku-4-5-20251001).
# COMPANION_MODEL=
