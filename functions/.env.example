# Non-secret settings. Copy to functions/.env (git-ignored). NOTE: Firebase
# deploys functions/.env with the function - never put API keys here.
#
# Secrets:
#   production:  firebase functions:secrets:set ANTHROPIC_API_KEY
#                firebase functions:secrets:set VULAVULA_API_KEY   (or "disabled")
#                firebase functions:secrets:set ADMIN_API_TOKEN    (or "disabled")
#   local dev:   functions/.secret.local  (git-ignored, not deployed), e.g.
#                ANTHROPIC_API_KEY=...
#                VULAVULA_API_KEY=...
#                ADMIN_API_TOKEN=...   (enables /admin/ for pinning campus places)

# Routing source of truth: the shared engine in routing/.
#   Local dev: leave these unset - the dev server starts the engine itself
#   (after routing/build.ps1 or build.sh).
#   Production (Cloud Run):
# ROUTING_MODE=http
# ROUTING_SERVICE_URL=https://witspath-routing-xxxxx.a.run.app/v1/route
# ROUTING_SERVICE_AUTH=id-token
#   With no engine configured, every route request returns an explicit error.

# Firestore collections shared with the Android app (confirmed from its source).
GRAPH_NODES_COLLECTION=nodes
GRAPH_EDGES_COLLECTION=edges
GRAPH_FLOORS_COLLECTION=floors
REPORTS_COLLECTION=reports

# Optional model override (defaults to claude-haiku-4-5-20251001).
# COMPANION_MODEL=
