{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "README.md",
      "firestore.companion.rules"
    ],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "companionMessage" } },
      { "source": "/share/**", "destination": "/share.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
      },
      {
        "source": "/share/**",
        "headers": [
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Robots-Tag", "value": "noindex" }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "companion",
      "ignore": ["node_modules", ".git", "test", "*.local", ".secret.local", "firebase-debug.log"]
    }
  ]
}
